{
  "name": "family-education-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Private family education operations workspace for a three-child household.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "lint": "eslint .",
    "private:backup": "node scripts/private-backup-all.mjs",
    "private:backup-storage": "node scripts/private-backup-storage.mjs",
    "private:check-env": "node scripts/private-check-env.mjs",
    "private:obsidian": "node scripts/private-export-obsidian.mjs",
    "private:restore": "node scripts/private-restore-backup.mjs",
    "private:restore-storage": "node scripts/private-restore-storage.mjs",
    "private:secrets": "node scripts/private-generate-secrets.mjs",
    "private:smoke": "node scripts/private-smoke-test.mjs",
    "test": "node --experimental-strip-types --test tests/core/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
