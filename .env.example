# Family Education Management System
# Copy this file to .env.local for local private integration.

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"

# Data mode:
# - local: demo data + browser localStorage
# - private-api: no-login private PWA backed by Supabase through /api/private/*
# - supabase: future authenticated SaaS mode
NEXT_PUBLIC_FAMILY_DATA_MODE="private-api"

# Private family workspace seeded by docs/private-pilot-seed-template.sql
NEXT_PUBLIC_PRIVATE_FAMILY_ID="11111111-1111-1111-1111-111111111111"

# Private PWA access code. Set a human-entered code for the family.
PRIVATE_ACCESS_CODE="choose-a-family-access-code"

# Calendar subscription token. Use a long random value, separate from access code.
PRIVATE_CALENDAR_TOKEN="choose-a-long-random-calendar-token"

# Storage bucket name for future Supabase Storage file uploads.
SUPABASE_LEARNING_MATERIALS_BUCKET="learning-materials"
