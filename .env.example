# Family Education Management System
# Copy this file to .env.local for local private integration.

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"

# Data mode:
# - local: demo data + browser localStorage
# - private-api: no-login private PWA backed by Supabase through /api/private/*
# - supabase: future authenticated SaaS mode
NEXT_PUBLIC_FAMILY_DATA_MODE="private-api"

# Private family workspace seeded by docs/private-pilot-seed-template.sql
NEXT_PUBLIC_PRIVATE_FAMILY_ID="11111111-1111-1111-1111-111111111111"

# Private PWA access codes. Parent/caregiver can open the full dashboard.
# Tutor/viewer codes are reserved for narrower future workflows and should not open the full dashboard.
# open = trusted-device parent link mode; code = require parent access code.
PRIVATE_PARENT_ACCESS_MODE="open"
PRIVATE_PARENT_ACCESS_CODE="choose-a-parent-access-code"
PRIVATE_CAREGIVER_ACCESS_CODE="choose-a-caregiver-access-code"
PRIVATE_TUTOR_ACCESS_CODE="choose-a-tutor-access-code"
PRIVATE_VIEWER_ACCESS_CODE="choose-a-viewer-access-code"

# Server-only HMAC secret for signed private access sessions.
PRIVATE_SESSION_SECRET="generate-with-npm-run-private-secrets"

# Backward compatibility only. Prefer PRIVATE_PARENT_ACCESS_CODE for new deployments.
PRIVATE_ACCESS_CODE=""

# iOS calendar subscription tokens live in public.family_settings.calendar_token.
# Rotate/revoke by updating that database value, then resubscribe iOS Calendar with the new URL.

# Storage bucket name for future Supabase Storage file uploads.
SUPABASE_LEARNING_MATERIALS_BUCKET="learning-materials"
